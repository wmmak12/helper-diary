# Helper Diary server settings. Copy to .env, fill in, and keep .env out of git.
# Run the built app with them:  node --env-file=.env release/server/server.mjs

# Owner account: email the household owner signs in with. Created on first start when no owner exists yet.
APP_ADMIN_EMAIL=owner@example.com
# Owner password: use a long unique one. Only its hash is stored.
APP_ADMIN_PASSWORD=change-me-to-a-long-unique-password

# Absolute path of the folder for the database and photos. It must survive restarts and redeploys (a lasting disk),
# and sit outside release/, which every build replaces.
DATA_DIR=/srv/helper-diary/data

# Optional text AI fallback (any OpenAI-compatible chat endpoint). Used for translation, talk notes and the
# template chat until the owner saves their own in Settings > AI settings. Leave empty to set it in the app only.
AI_BASE_URL=https://api.example.com/v1
# Optional API key for AI_BASE_URL. Read on the server only, never sent to the browser.
AI_API_KEY=your-api-key
# Optional model id at AI_BASE_URL, for example a chat model your provider lists.
AI_MODEL=your-chat-model
# Speech to text (Hold to talk) has no server setting: the owner enters its address, key and model in Settings.

# Time zone the household lives in (IANA name). Sets "today" for tasks and the calendar. Default Asia/Singapore.
HOUSEHOLD_TZ=Asia/Singapore

# Port the server listens on. Default 8080.
PORT=8080
# Address the server binds to. Default 0.0.0.0 (all interfaces).
HOST=0.0.0.0
